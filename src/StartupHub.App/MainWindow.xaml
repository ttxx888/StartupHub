<Window x:Class="StartupHub.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:StartupHub.App" Style="{StaticResource {x:Type Window}}" Title="启动台" Width="1240" Height="780" MinWidth="900" MinHeight="500">
 <Window.Resources>
  <Style x:Key="ExpandedNavigationLabel" TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding SidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="SidebarNavigationButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="10,8"/><Style.Triggers><DataTrigger Binding="{Binding SidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="HorizontalContentAlignment" Value="Center"/></DataTrigger></Style.Triggers></Style>
 </Window.Resources>
 <Window.InputBindings><KeyBinding Key="N" Modifiers="Control" Command="{Binding AddCommand}"/><KeyBinding Key="F5" Command="{Binding RefreshCommand}"/><KeyBinding Key="E" Modifiers="Control" Command="{Binding EditCommand}"/></Window.InputBindings>
 <AdornerDecorator><Grid x:Name="RootLayout" Background="{DynamicResource CanvasBrush}" SizeChanged="OnLayoutSizeChanged">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="SidebarPanel" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="10,20,10,16" ClipToBounds="True">
   <DockPanel>
    <Grid DockPanel.Dock="Top" Margin="2,0,2,24">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding SidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Image Source="assets/startuphub.png" Width="28" Height="28" Margin="0,0,8,0"/><TextBlock Text="启动台" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
     <Button x:Name="SidebarToggle" Grid.Column="1" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="30" Height="32" MinHeight="32" Padding="6" Margin="0" Style="{StaticResource QuietButton}" Click="OnToggleSidebar" ToolTip="收起侧栏" AutomationProperties.Name="收起侧栏"/>
    </Grid>
    <StackPanel DockPanel.Dock="Bottom">
     <Border Height="1" Background="{DynamicResource LineBrush}" Margin="6,12,6,12"/>
     <Button Style="{StaticResource SidebarNavigationButton}" Command="{Binding DiscoverCommand}" Margin="0,0,0,4" ToolTip="发现本地网页" AutomationProperties.Name="发现本地网页"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" Width="20" VerticalAlignment="Center"/><TextBlock Text="发现本地网页" Style="{StaticResource ExpandedNavigationLabel}"/></StackPanel></Button>
     <Button Style="{StaticResource SidebarNavigationButton}" Command="{Binding GroupsCommand}" Margin="0,0,0,4" ToolTip="管理分类" AutomationProperties.Name="管理分类"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Width="20" VerticalAlignment="Center"/><TextBlock Text="管理分类" Style="{StaticResource ExpandedNavigationLabel}"/></StackPanel></Button>
     <Button Style="{StaticResource SidebarNavigationButton}" Command="{Binding SettingsCommand}" Margin="0" ToolTip="设置与配置" AutomationProperties.Name="设置与配置"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="20" VerticalAlignment="Center"/><TextBlock Text="设置与配置" Style="{StaticResource ExpandedNavigationLabel}"/></StackPanel></Button>
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Text="工作空间" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,12" Style="{StaticResource ExpandedNavigationLabel}"/>
    <ListBox x:Name="CategoryList" local:ScrollEffects.Enabled="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" AllowDrop="True" PreviewMouseLeftButtonDown="OnCategoryMouseDown" PreviewMouseLeftButtonUp="OnCategoryMouseUp" PreviewMouseMove="OnCategoryMouseMove" DragOver="OnCategoryDragOver" Drop="OnCategoryDrop" DragLeave="OnTargetDragLeave" ItemsSource="{Binding CategoryItems}" SelectedValuePath="Name" SelectedValue="{Binding SelectedGroup}" AutomationProperties.Name="任务分类">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="10,10"/><Setter Property="ToolTip" Value="{Binding Description}"/><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/><Style.Triggers><DataTrigger Binding="{Binding SidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Padding" Value="4,9"/></DataTrigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Grid>
      <Grid><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding SidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DockPanel><TextBlock Text="⋮" Cursor="SizeAll" Foreground="{DynamicResource MutedBrush}" Margin="0,0,6,0" ToolTip="拖动调整分类顺序"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Name}" Value="全部任务"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/></Grid>
      <TextBlock Text="{Binding ShortName}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="24,24,24,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="WorkspaceHeader" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SelectedGroup}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedGroup}"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="启动自启项" Command="{Binding StartAutoCommand}"/><Button Content="＋ 添加任务" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" Margin="0,0,0,8"/></StackPanel></Grid>
   <Grid Grid.Row="1" Height="40" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="132"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid Margin="0,0,12,0"><TextBox x:Name="SearchBox" Padding="32,8,12,8" VerticalContentAlignment="Center" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索任务" ToolTip="搜索名称、说明或路径（Ctrl+F）"/><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBlock Text="搜索任务、路径…" Foreground="{DynamicResource MutedBrush}" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    <ComboBox x:Name="StatusFilterBox" Grid.Column="1" ItemsSource="{Binding Filters}" SelectedItem="{Binding StatusFilter}" AutomationProperties.Name="状态筛选"/>
    <Button Grid.Column="2" x:Name="DetailsButton" Content="收起详情" Click="OnToggleDetails" Margin="12,0,8,0"/>
    <Button Grid.Column="3" Content="···" ToolTip="批量操作" AutomationProperties.Name="批量操作" Click="OnOpenMenu" Margin="0"><Button.ContextMenu><ContextMenu><MenuItem Header="刷新状态    F5" Command="{Binding RefreshCommand}"/><MenuItem Header="打开可用页面" Command="{Binding OpenAllCommand}"/><Separator/><MenuItem Header="停止受管服务" Command="{Binding StopAllCommand}"/></ContextMenu></Button.ContextMenu></Button>
   </Grid>
   <Grid Grid.Row="2" x:Name="Workspace">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailColumn" Width="336"/></Grid.ColumnDefinitions>
    <Border AllowDrop="True" DragOver="OnTaskDragOver" Drop="OnTaskDrop" DragLeave="OnTargetDragLeave" x:Name="ListPanel" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="{StaticResource PanelRadius}" Padding="0,8">
     <DockPanel><WrapPanel DockPanel.Dock="Top" Margin="12,4,12,8" Visibility="{Binding HasMultipleSelection, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center" Margin="0,0,12,8"/><Button Content="移动到分类…" Command="{Binding MoveSelectionCommand}"/><Button Content="删除所选…" Command="{Binding DeleteCommand}"/></WrapPanel><Grid><DataGrid RowStyle="{StaticResource {x:Type DataGridRow}}" CellStyle="{StaticResource {x:Type DataGridCell}}" x:Name="TaskList" local:ScrollEffects.Enabled="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" AllowDrop="True" PreviewMouseLeftButtonDown="OnTaskMouseDown" PreviewMouseLeftButtonUp="OnTaskMouseUp" PreviewMouseMove="OnTaskMouseMove" DragOver="OnTaskDragOver" Drop="OnTaskDrop" DragLeave="OnTargetDragLeave" ItemsSource="{Binding TasksView}" SelectionChanged="OnTaskSelectionChanged" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserResizeColumns="False" HeadersVisibility="None" RowHeight="68" SelectionMode="Extended" SelectionUnit="FullRow" BorderThickness="0" MouseDoubleClick="OnDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <DataGrid.ContextMenu><ContextMenu><MenuItem Header="启动 / 打开" Command="{Binding StartCommand}"/><MenuItem Header="编辑" Command="{Binding EditCommand}"/><MenuItem Header="复制" Command="{Binding CopyCommand}"/><Separator/><MenuItem Header="停止" Command="{Binding StopCommand}"/><MenuItem Header="重启" Command="{Binding RestartCommand}"/><Separator/><MenuItem Header="移动到分类…" Command="{Binding MoveSelectionCommand}"/><MenuItem Header="删除所选…" Command="{Binding DeleteCommand}"/></ContextMenu></DataGrid.ContextMenu>
      <DataGrid.Columns><DataGridTemplateColumn Width="20" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="⋮" Foreground="{DynamicResource MutedBrush}" FontSize="18" Cursor="SizeAll" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="拖动调整顺序，或拖到左侧分类"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding AutoStart, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" ToolTip="登录自启" AutomationProperties.Name="登录自启"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Width="36" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{DynamicResource CanvasBrush}" CornerRadius="8" Width="30" Height="30"><TextBlock Text="{Binding KindGlyph}" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedBrush}" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="{Binding Entry.KindText}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Width="*" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="10,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Entry.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Entry.Name}"/><TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" ToolTip="{Binding Entry.Address}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Width="76" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status.Text}" Foreground="{Binding StatusBrush}" FontSize="12" VerticalAlignment="Center" ToolTip="{Binding Status.Detail}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Width="42" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" Padding="6" MinHeight="30" Margin="0,0,8,0" Click="OnRowStart" ToolTip="启动 / 打开" AutomationProperties.Name="启动此任务" Style="{StaticResource QuietButton}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding EmptyTitle}" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="{Binding EmptyDescription}" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,20" TextWrapping="Wrap" TextAlignment="Center"/><Button Content="添加任务" Command="{Binding AddCommand}" Visibility="{Binding HasNoTasks, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Center"/><Button Content="清除筛选" Command="{Binding ClearFiltersCommand}" Visibility="{Binding HasTasks, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Center"/></StackPanel>
     </Grid></DockPanel>
    </Border>
    <Border x:Name="DetailPanel" Grid.Column="1" Width="320" HorizontalAlignment="Right" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="{StaticResource PanelRadius}" Padding="18" Panel.ZIndex="2">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel><DockPanel><Button Content="×" DockPanel.Dock="Right" Click="OnToggleDetails" Style="{StaticResource QuietButton}" Padding="6" MinHeight="26" Margin="8,0,0,0" ToolTip="收起详情"/><TextBlock Text="{Binding DetailTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="58" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailTitle}"/></DockPanel><TextBlock Visibility="{Binding HasSingleSelection, Converter={StaticResource BoolVisibility}}" Text="{Binding Selected.Status.Text}" Foreground="{Binding Selected.StatusBrush}" Margin="0,10,0,16"/></StackPanel>
      <WrapPanel Grid.Row="1" Visibility="{Binding HasSingleSelection, Converter={StaticResource BoolVisibility}}"><Button Content="启动 / 打开" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}"/><Button Content="编辑" Command="{Binding EditCommand}"/><Button Content="停止" Command="{Binding StopCommand}"/><Button Content="重启" Command="{Binding RestartCommand}"/><Button Content="更多 ···" Click="OnOpenMenu"><Button.ContextMenu><ContextMenu><MenuItem Header="打开页面" Command="{Binding OpenPageCommand}"/><MenuItem Header="打开目录" Command="{Binding OpenFolderCommand}"/><Separator/><MenuItem Header="复制任务" Command="{Binding CopyCommand}"/><MenuItem Header="上移" Command="{Binding UpCommand}"/><MenuItem Header="下移" Command="{Binding DownCommand}"/><Separator/><MenuItem Header="移动到分类…" Command="{Binding MoveSelectionCommand}"/><MenuItem Header="删除所选…" Command="{Binding DeleteCommand}"/></ContextMenu></Button.ContextMenu></Button></WrapPanel>
      <WrapPanel Grid.Row="1" Visibility="{Binding HasMultipleSelection, Converter={StaticResource BoolVisibility}}"><Button Content="移动到分类…" Command="{Binding MoveSelectionCommand}"/><Button Content="删除所选…" Command="{Binding DeleteCommand}"/></WrapPanel>
      <TabControl Grid.Row="2" Margin="0,8,0,0"><TabItem Header="详情"><ScrollViewer local:ScrollEffects.Enabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding DetailFields}" Margin="0,16,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,18"><TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,6"/><TextBlock Text="{Binding Value}" TextWrapping="Wrap" LineHeight="22"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></TabItem>
       <TabItem Header="日志"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><Button Content="刷新日志" Command="{Binding LogsCommand}"/><Button Content="日志目录" Command="{Binding LogFolderCommand}"/></WrapPanel><TextBox Grid.Row="1" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" BorderThickness="0" Padding="0"/></Grid></TabItem>
      </TabControl>
     </Grid>
    </Border>
   </Grid>
   <StackPanel Grid.Row="3" Margin="0,14,0,0"><DockPanel Visibility="{Binding BatchActive, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="取消待启动" Command="{Binding CancelCommand}" Margin="12,0,0,0"/><ProgressBar IsIndeterminate="True" Height="3" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding Message}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" MaxHeight="36"/></StackPanel>
  </Grid>
 </Grid>
</AdornerDecorator></Window>




